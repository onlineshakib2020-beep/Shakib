# GEMINI_API_KEY: Required for live Gemini AI API calls (Server-side only; never exposed to browser).
# AI Studio automatically injects this at runtime from user secrets.
# Configure a valid Gemini API key (starting with AIza...) via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides for Gemini Live API and Flash tool-calling:
GEMINI_LIVE_MODEL="gemini-3.8-live"
GEMINI_FLASH_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
# Google Maps API Key for Kiln Map Location & Satellite Navigation
VITE_GOOGLE_MAPS_API_KEY=""
